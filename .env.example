# Firebase Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Email Settings
# IMPORTANT: For Gmail, you MUST use an "App Password", NOT your regular Google account password.
# To generate one: Go to Google Account -> Security -> 2-Step Verification -> App Passwords.
# Select 'Mail' and 'Other (Custom Name)', then copy the 16-character code.
ADMIN_EMAIL_USER=your-email@gmail.com
ADMIN_EMAIL_PASS=your-16-char-app-password

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# AI Chatbot (Gemini) — Server-side only, NOT exposed to browser
GEMINI_API_KEY=

# Payment Gateway (Razorpay) — Server-side only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS — Comma-separated list of allowed origins (for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
