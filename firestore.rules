rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 1. IDENTITY & ADMIN HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() { return request.auth != null; }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }
    
    function isHardcodedAdmin() {
      return isSignedIn() && 
             (
               ('email' in request.auth.token && request.auth.token.email != null && (
                 request.auth.token.email.lower() == 'mustakansari9582@gmail.com' ||
                 request.auth.token.email.lower() == 'atomichvacsolutions@gmail.com' ||
                 request.auth.token.email.lower() == 'atomichvacsolution@gmail.com'
               )) ||
               ('phone_number' in request.auth.token && request.auth.token.phone_number == '+919582268658')
             );
    }

    // Full Admin check (can be used in get/write rules)
    function isAdmin() { 
      return isHardcodedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      ); 
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStaff == true)
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // 0. GLOBAL SAFETY NET
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 2. ENTITY PILLARS (Collection Rules)
    // -------------------------------------------------------------------------

    // --- USERS ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- BOOKINGS ---
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || existing().staffId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.staffId == request.auth.uid || isAdmin());
      allow create: if isSignedIn(); // Any signed-in user can create a booking
      allow update: if isSignedIn() && (
        isAdmin() || 
        (existing().staffId == request.auth.uid) || // Staff can update assigned bookings
        isOwner(existing().userId) // Owner can cancel/update
      );
      allow delete: if isAdmin();
    }

    // --- SERVICES & CATEGORIES ---
    match /services/{serviceId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can modify services
    }
    match /categories/{categoryId} {
      allow read: if true; // Publicly readable
      allow write: if isAdmin(); // Only admins can modify categories
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || (existing().userId == 'admin' && isAdmin()));
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || (resource.data.userId == 'admin' && isAdmin()));
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // --- GALLERY ---
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- INVOICES ---
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // --- SETTINGS ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- REPORTS ---
    match /reports/{reportId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isOwner(incoming().userId);
      allow update, delete: if isAdmin();
    }
    // --- CHATS ---
    match /chats/{chatId} {
      allow read: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      }
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- STORE ---
    match /store_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /store_orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
