rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. IDENTITY & ADMIN HELPERS
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isHardcodedAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email in [
          'mustakansari9582@gmail.com',
          'atomichvacsolutions@gmail.com',
          'atomichvacsolution@gmail.com'
        ]) ||
        (request.auth.token.phone_number != null && request.auth.token.phone_number == '+919582268658')
      );
    }

    function isAdmin() {
      return isHardcodedAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isStaff == true)
      );
    }

    // 0. GLOBAL SAFETY NET
    match /{document=**} {
      allow read, write: if false;
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- BOOKINGS ---
    match /bookings/{bookingId} {
      allow create: if true;
      allow read: if isAdmin() || isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || isStaff() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- SERVICES & CATEGORIES ---
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.target == 'all'));
      allow write: if isAdmin() || isStaff();
    }

    // --- GALLERY ---
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- INVOICES (Financial Security) ---
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || isStaff() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.customerUserId == request.auth.uid));
      allow write: if isAdmin() || isStaff();
    }

    // --- EXPENSES (Confidential Accounting) ---
    match /expenses/{expenseId} {
      allow read, write: if isAdmin() || isStaff();
    }

    // --- SETTINGS ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- REPORTS ---
    match /reports/{reportId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- CHATS ---
    match /chats/{chatId} {
      allow read: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (chatId == request.auth.uid || isAdmin());
      }
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- STORE ---
    match /store_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /store_orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
